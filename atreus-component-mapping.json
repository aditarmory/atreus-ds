  "how_to_update": {
    "when_figma_changes": [
      "1. Open the updated Figma component",
      "2. Note which properties changed (color, size, spacing, new variant)",
      "3. Update the corresponding entry in this JSON",
      "4. Update css/styles.css for token/CSS changes",
      "5. Update pages/{component}.html for structural/variant changes",
      "6. Update js/main.js if data objects (COLORS, TYPO, SPACING) changed",
      "7. Re-export tokens JSON if needed (use Export button in DS site)"
    ],
    "when_code_changes": [
      "1. Update code_file path if file moved/renamed",
      "2. Update css_classes if class names changed",
      "3. Update figma_props_to_css if prop mapping changed"
    ],
    "automation_note": "This file is manually maintained. For automated sync, upgrade to Figma Organization plan and use the figma-code-connect-components skill with send_code_connect_mappings()."
